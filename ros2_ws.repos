# The repositories this one builds from source. tools/import_interfaces.py
# reads this file, and it is also a valid vcstool file. Only
# ros2_ws/src/walkie_vision_msgs in the clone is built. The version is a full
# commit, never a branch, so a build cannot silently change types.
repositories:
  ros2_ws/src/walkie-vision:
    type: git
    url: https://github.com/EIC-Robocup-2026/walkie-vision.git
    version: 60721b63733991e0f8a78b56c6fdf5987979ea02
