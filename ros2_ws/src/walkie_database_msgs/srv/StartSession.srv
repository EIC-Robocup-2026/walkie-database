# Starts a session: one run of a task, such as one Receptionist attempt. The
# people met in it are forgotten with it (walkie-database ADR-0010). At most
# one session is open at a time (ADR-0017).

# Stored as session.label, for example "walkie-agent". Empty stores none.
# Spaces at either end are ignored. Ignored when an open session is resumed.
string label
# True: keep the open session and return it, so that the guests met before
# an agent restart are still recognised. A new session is started only when
# none is open. False: forget the open session and its people first, then
# start a new one.
bool resume
---
# False when the database failed. message then starts with "The database
# could not" and says why.
bool success
# For example "Started session 5.", "Resumed session 4, with 2 people." or
# "Forgot session 4 and its 2 people, and started session 5."
string message
# session.id of the open session. A new session never gets the id of a
# forgotten one.
int64 session_id
# True when an open session was kept instead of a new one started.
bool resumed
# How many people the open session holds. 0 for a new session.
uint32 people
# When the open session started.
builtin_interfaces/Time started_at
# The models whose vectors remember_person stores and match_faces and
# match_appearances search, in the order of their names. The node refuses a
# vector of any other model (ADR-0006), so a caller leaves those out before
# it sends. Only a schema migration changes these lists.
ModelInfo[] face_models
ModelInfo[] appearance_models
